# =============================================================================
#  Variaveis de ambiente da PoC (Atividade 3)
#  Copie para `.env` e exporte antes de rodar, ou passe por linha de comando.
#  NUNCA versione o .env real com senhas (o .gitignore ja ignora *.env).
# =============================================================================

# Broker MQTT de destino.
MQTT_HOST=localhost
MQTT_PORT=1883

# Intervalo de envio por sensor, em segundos (60 = operacao planejada).
MQTT_INTERVALO=60

# Credenciais (deixe em branco para broker anonimo da PoC local).
MQTT_USER=
MQTT_PASSWORD=
