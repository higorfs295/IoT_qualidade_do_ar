{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ConnectOnlyAsAttachedThing",
      "Effect": "Allow",
      "Action": "iot:Connect",
      "Resource": "arn:aws:iot:REGION:ACCOUNT_ID:client/${iot:Connection.Thing.ThingName}",
      "Condition": {
        "Bool": {
          "iot:Connection.Thing.IsAttached": "true"
        }
      }
    },
    {
      "Sid": "PublishOwnTelemetryAndStatus",
      "Effect": "Allow",
      "Action": "iot:Publish",
      "Resource": [
        "arn:aws:iot:REGION:ACCOUNT_ID:topic/qualidade-ar/${iot:Connection.Thing.Attributes[siteId]}/${iot:Connection.Thing.ThingName}/telemetria",
        "arn:aws:iot:REGION:ACCOUNT_ID:topic/qualidade-ar/${iot:Connection.Thing.Attributes[siteId]}/${iot:Connection.Thing.ThingName}/status"
      ]
    }
  ]
}
