{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Sandbox Air Sense: IoT Rule, SQS/DLQ, Lambda, S3 bruto, DynamoDB e alarmes.",
  "Parameters": {
    "EnvironmentName": {
      "Type": "String",
      "Default": "dev",
      "AllowedPattern": "^[a-z0-9-]+$"
    },
    "RawRetentionDays": {
      "Type": "Number",
      "Default": 30,
      "MinValue": 1,
      "MaxValue": 3650
    },
    "LambdaCodeS3Bucket": {
      "Type": "String",
      "Description": "Bucket que contem o ZIP gerado por lambda_ingest/package.py."
    },
    "LambdaCodeS3Key": {
      "Type": "String",
      "Description": "Chave S3 do ZIP do consumidor."
    },
    "LambdaCodeS3ObjectVersion": {
      "Type": "String",
      "Default": "",
      "Description": "VersionId opcional do ZIP quando o bucket de artefatos usa versionamento."
    },
    "LambdaReservedConcurrency": {
      "Type": "Number",
      "Default": 2,
      "MinValue": 2,
      "MaxValue": 100
    }
  },
  "Conditions": {
    "HasLambdaCodeVersion": {
      "Fn::Not": [{ "Fn::Equals": [{ "Ref": "LambdaCodeS3ObjectVersion" }, ""] }]
    }
  },
  "Resources": {
    "TelemetryDlq": {
      "Type": "AWS::SQS::Queue",
      "Properties": {
        "SqsManagedSseEnabled": true,
        "MessageRetentionPeriod": 1209600,
        "Tags": [{ "Key": "Project", "Value": "air-sense" }, { "Key": "Environment", "Value": { "Ref": "EnvironmentName" } }]
      }
    },
    "TelemetryQueue": {
      "Type": "AWS::SQS::Queue",
      "Properties": {
        "SqsManagedSseEnabled": true,
        "VisibilityTimeout": 120,
        "MessageRetentionPeriod": 345600,
        "ReceiveMessageWaitTimeSeconds": 20,
        "RedrivePolicy": {
          "deadLetterTargetArn": { "Fn::GetAtt": ["TelemetryDlq", "Arn"] },
          "maxReceiveCount": 5
        },
        "Tags": [{ "Key": "Project", "Value": "air-sense" }, { "Key": "Environment", "Value": { "Ref": "EnvironmentName" } }]
      }
    },
    "RawBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [{ "ServerSideEncryptionByDefault": { "SSEAlgorithm": "AES256" } }]
        },
        "OwnershipControls": { "Rules": [{ "ObjectOwnership": "BucketOwnerEnforced" }] },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "LifecycleConfiguration": {
          "Rules": [{
            "Id": "ExpireRaw",
            "Status": "Enabled",
            "ExpirationInDays": { "Ref": "RawRetentionDays" }
          }]
        },
        "Tags": [{ "Key": "Project", "Value": "air-sense" }, { "Key": "Environment", "Value": { "Ref": "EnvironmentName" } }]
      }
    },
    "CurrentStateTable": {
      "Type": "AWS::DynamoDB::Table",
      "Properties": {
        "BillingMode": "PAY_PER_REQUEST",
        "SSESpecification": { "SSEEnabled": true },
        "AttributeDefinitions": [{ "AttributeName": "device_key", "AttributeType": "S" }],
        "KeySchema": [{ "AttributeName": "device_key", "KeyType": "HASH" }],
        "PointInTimeRecoverySpecification": { "PointInTimeRecoveryEnabled": true },
        "Tags": [{ "Key": "Project", "Value": "air-sense" }, { "Key": "Environment", "Value": { "Ref": "EnvironmentName" } }]
      }
    },
    "IoTRuleRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [{
            "Effect": "Allow",
            "Principal": { "Service": "iot.amazonaws.com" },
            "Action": "sts:AssumeRole"
          }]
        },
        "Policies": [{
          "PolicyName": "DeliverTelemetry",
          "PolicyDocument": {
            "Version": "2012-10-17",
            "Statement": [
              {
                "Effect": "Allow",
                "Action": "sqs:SendMessage",
                "Resource": [
                  { "Fn::GetAtt": ["TelemetryQueue", "Arn"] },
                  { "Fn::GetAtt": ["TelemetryDlq", "Arn"] }
                ]
              },
              {
                "Effect": "Allow",
                "Action": "s3:PutObject",
                "Resource": { "Fn::Sub": "${RawBucket.Arn}/raw/*" }
              }
            ]
          }
        }],
        "Tags": [{ "Key": "Project", "Value": "air-sense" }, { "Key": "Environment", "Value": { "Ref": "EnvironmentName" } }]
      }
    },
    "TelemetryRule": {
      "Type": "AWS::IoT::TopicRule",
      "Properties": {
        "TopicRulePayload": {
          "AwsIotSqlVersion": "2016-03-23",
          "RuleDisabled": false,
          "Sql": "SELECT *, topic() AS mqtt_topic, timestamp() AS ingested_at FROM 'qualidade-ar/+/+/telemetria'",
          "Actions": [
            {
              "Sqs": {
                "QueueUrl": { "Ref": "TelemetryQueue" },
                "RoleArn": { "Fn::GetAtt": ["IoTRuleRole", "Arn"] },
                "UseBase64": false
              }
            },
            {
              "S3": {
                "BucketName": { "Ref": "RawBucket" },
                "Key": "raw/${topic(2)}/${topic(3)}/${timestamp()}-${message_id}.json",
                "RoleArn": { "Fn::GetAtt": ["IoTRuleRole", "Arn"] }
              }
            }
          ],
          "ErrorAction": {
            "Sqs": {
              "QueueUrl": { "Ref": "TelemetryDlq" },
              "RoleArn": { "Fn::GetAtt": ["IoTRuleRole", "Arn"] },
              "UseBase64": false
            }
          }
        }
      }
    },
    "LambdaIngestRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [{
            "Effect": "Allow",
            "Principal": { "Service": "lambda.amazonaws.com" },
            "Action": "sts:AssumeRole"
          }]
        },
        "Policies": [{
          "PolicyName": "ConsumeTelemetry",
          "PolicyDocument": {
            "Version": "2012-10-17",
            "Statement": [
              {
                "Effect": "Allow",
                "Action": ["sqs:ReceiveMessage", "sqs:DeleteMessage", "sqs:GetQueueAttributes"],
                "Resource": { "Fn::GetAtt": ["TelemetryQueue", "Arn"] }
              },
              {
                "Effect": "Allow",
                "Action": "dynamodb:PutItem",
                "Resource": { "Fn::GetAtt": ["CurrentStateTable", "Arn"] }
              },
              {
                "Effect": "Allow",
                "Action": "logs:CreateLogGroup",
                "Resource": { "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:*" }
              },
              {
                "Effect": "Allow",
                "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
                "Resource": { "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/lambda/${AWS::StackName}-ingest:*" }
              }
            ]
          }
        }],
        "Tags": [{ "Key": "Project", "Value": "air-sense" }, { "Key": "Environment", "Value": { "Ref": "EnvironmentName" } }]
      }
    },
    "LambdaLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": { "Fn::Sub": "/aws/lambda/${AWS::StackName}-ingest" },
        "RetentionInDays": 30
      }
    },
    "TelemetryIngestFunction": {
      "Type": "AWS::Lambda::Function",
      "DependsOn": ["LambdaLogGroup"],
      "Properties": {
        "FunctionName": { "Fn::Sub": "${AWS::StackName}-ingest" },
        "Description": "Valida telemetria v1.1 e atualiza o estado atual idempotente.",
        "Runtime": "python3.13",
        "Handler": "handler.handler",
        "Role": { "Fn::GetAtt": ["LambdaIngestRole", "Arn"] },
        "MemorySize": 256,
        "Timeout": 30,
        "ReservedConcurrentExecutions": { "Ref": "LambdaReservedConcurrency" },
        "Code": {
          "S3Bucket": { "Ref": "LambdaCodeS3Bucket" },
          "S3Key": { "Ref": "LambdaCodeS3Key" },
          "S3ObjectVersion": {
            "Fn::If": ["HasLambdaCodeVersion", { "Ref": "LambdaCodeS3ObjectVersion" }, { "Ref": "AWS::NoValue" }]
          }
        },
        "Environment": {
          "Variables": { "CURRENT_STATE_TABLE": { "Ref": "CurrentStateTable" } }
        },
        "Tags": [{ "Key": "Project", "Value": "air-sense" }, { "Key": "Environment", "Value": { "Ref": "EnvironmentName" } }]
      }
    },
    "TelemetryQueueMapping": {
      "Type": "AWS::Lambda::EventSourceMapping",
      "Properties": {
        "EventSourceArn": { "Fn::GetAtt": ["TelemetryQueue", "Arn"] },
        "FunctionName": { "Ref": "TelemetryIngestFunction" },
        "Enabled": true,
        "BatchSize": 10,
        "MaximumBatchingWindowInSeconds": 5,
        "FunctionResponseTypes": ["ReportBatchItemFailures"],
        "ScalingConfig": { "MaximumConcurrency": { "Ref": "LambdaReservedConcurrency" } }
      }
    },
    "DlqVisibleAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmDescription": "Ha mensagens de telemetria na DLQ.",
        "Namespace": "AWS/SQS",
        "MetricName": "ApproximateNumberOfMessagesVisible",
        "Dimensions": [{ "Name": "QueueName", "Value": { "Fn::GetAtt": ["TelemetryDlq", "QueueName"] } }],
        "Statistic": "Maximum",
        "Period": 300,
        "EvaluationPeriods": 1,
        "Threshold": 0,
        "ComparisonOperator": "GreaterThanThreshold",
        "TreatMissingData": "notBreaching"
      }
    },
    "QueueAgeAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmDescription": "A fila de telemetria esta atrasada por mais de cinco minutos.",
        "Namespace": "AWS/SQS",
        "MetricName": "ApproximateAgeOfOldestMessage",
        "Dimensions": [{ "Name": "QueueName", "Value": { "Fn::GetAtt": ["TelemetryQueue", "QueueName"] } }],
        "Statistic": "Maximum",
        "Period": 300,
        "EvaluationPeriods": 1,
        "Threshold": 300,
        "ComparisonOperator": "GreaterThanThreshold",
        "TreatMissingData": "notBreaching"
      }
    },
    "LambdaErrorsAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmDescription": "O consumidor Lambda registrou erro de invocacao.",
        "Namespace": "AWS/Lambda",
        "MetricName": "Errors",
        "Dimensions": [{ "Name": "FunctionName", "Value": { "Ref": "TelemetryIngestFunction" } }],
        "Statistic": "Sum",
        "Period": 300,
        "EvaluationPeriods": 1,
        "Threshold": 0,
        "ComparisonOperator": "GreaterThanThreshold",
        "TreatMissingData": "notBreaching"
      }
    }
  },
  "Outputs": {
    "TelemetryQueueUrl": { "Value": { "Ref": "TelemetryQueue" } },
    "TelemetryDlqUrl": { "Value": { "Ref": "TelemetryDlq" } },
    "RawBucketName": { "Value": { "Ref": "RawBucket" } },
    "CurrentStateTableName": { "Value": { "Ref": "CurrentStateTable" } },
    "TelemetryIngestFunctionName": { "Value": { "Ref": "TelemetryIngestFunction" } },
    "TelemetryIngestFunctionArn": { "Value": { "Fn::GetAtt": ["TelemetryIngestFunction", "Arn"] } },
    "IoTRuleRoleArn": { "Value": { "Fn::GetAtt": ["IoTRuleRole", "Arn"] } }
  }
}
