# =============================================================================
#  Variaveis do docker-compose da PoC (Atividade 3)
#  Copie para `.env` e ajuste. NUNCA versione o .env real (contem segredos).
# =============================================================================

# Senha do PostgreSQL usado pelo ThingsBoard.
TB_POSTGRES_PASSWORD=troque-esta-senha-antes-de-subir

# Instalacao do schema do ThingsBoard.
# Na PRIMEIRA subida da plataforma, use:
#   INSTALL_TB=true
#   LOAD_DEMO=true      # dados de demonstracao (opcional)
# Depois que o schema estiver instalado, volte ambos para false para nao
# reinstalar a cada reinicio.
INSTALL_TB=false
LOAD_DEMO=false
